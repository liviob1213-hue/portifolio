# Normalize line endings: store as LF, keep text diffs stable across Windows/Linux.
* text=auto eol=lf

# Binary assets — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.mov binary
*.pdf binary

# Keep these exactly as generated
package-lock.json -diff linguist-generated
